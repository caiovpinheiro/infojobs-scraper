FROM mcr.microsoft.com/playwright:v1.48.0-jammy
WORKDIR /app
RUN apt-get update && apt-get install -y xvfb && rm -rf /var/lib/apt/lists/*
RUN npm init -y && npm install express@4 playwright@1.48.0
RUN echo "" | base64 -d > server.js
ENV PORT=3000
EXPOSE 3000
CMD ["xvfb-run", "-a", "--server-args=-screen 0 1440x900x24", "node", "server.js"]
