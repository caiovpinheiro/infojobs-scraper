# Copie para .env apenas no servidor. No Easypanel, defina as mesmas chaves em Environment.
PORT=3000
APP_USER=operador
APP_PASSWORD=troque-por-uma-senha-longa
# URL acessível pelo servidor do painel. O token é o AUTH_TOKEN definido no serviço pandape-login.
PANDAPE_LOGIN_URL=https://seu-pandape-login.example.com
PANDAPE_LOGIN_TOKEN=cole-o-token-do-servico-pandape-login
# Opcional. Webhook de deploy do EasyPanel do serviço pandape-login.
# Usado só se o cookie vencer e /cookie?force=1 continuar devolvendo sessão vencida.
PANDAPE_LOGIN_DEPLOY_URL=
# Alternativa manual: remova as duas variáveis acima e informe PANDAPE_COOKIE=ats-webui=...
CRM_BASE_URL=https://integrations.bwipo.com/api
CRM_API_KEY=cole-a-chave-do-bwipo
CRM_STAGE_ID=cole-o-id-da-etapa-destino
CRM_TAG_ID=cole-o-id-da-tag-ou-deixe-vazio

# Classificação fixa por ID de vaga. Use ESTAGIO sem acento. Ex.: {"12345":"CLT","67890":"ESTAGIO"}
VACANCY_TYPES_JSON={}

# Limites de segurança e de leitura. Máximo permitido: 2000 vagas, 2000 candidatos, 500 por lote.
MAX_VACANCIES=100
MAX_CANDIDATES=500
MAX_IMPORT=100

# Postgres do Easypanel. Use o host interno do banco quando o painel roda no mesmo projeto.
DATABASE_URL=postgres://postgres:senha@dnaworkia_banco:5432/dnaworkia?sslmode=disable
